# Server Runtime Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0
APP_NAME=hax-media-downloader
APP_URL=http://localhost:3000
CORS_ORIGIN=*

# Security & Access Control
ADMIN_API_KEY=
CRON_SECRET=
API_KEY_HEADER=x-api-key

# Rate Limiting (Default: 10 downloads per hour per IP/user)
# Note: In-memory rate limits are process-local and not shared between distributed replicas
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=3600000
ADMIN_RATE_LIMIT_MAX_REQUESTS=1000
ADMIN_RATE_LIMIT_WINDOW_MS=3600000

# Storage & Temporary Directories
TEMP_DIR=/app/temp
MAX_FILE_SIZE_MB=100
MAX_CONCURRENT_DOWNLOADS=3
CLEANUP_INTERVAL_MINUTES=15
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800
JOB_EXPIRATION_SECONDS=3600

# Provider Prioritization & Timeouts
PROVIDER_PRIORITY=ytdlp,cobalt,external
PROVIDER_TIMEOUT_MS=30000

# yt-dlp Provider Configuration
YTDLP_ENABLED=true
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT_MS=45000
# JS Runtime for YouTube challenge solving: auto (prefers Deno 2.x, then Node 22+), deno, node, or none
YTDLP_JS_RUNTIME=auto
# EJS Remote Component source: ejs:github, ejs:npm, or none
YTDLP_REMOTE_COMPONENTS=ejs:github

# Cobalt Provider Configuration (Secondary fallback - must NOT hardcode a public instance)
COBALT_ENABLED=true
COBALT_API_URL=
COBALT_API_KEY=
COBALT_TIMEOUT_MS=20000

# External Fallback Provider Configuration (Tertiary fallback)
EXTERNAL_API_ENABLED=false
EXTERNAL_API_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_HEADER=x-api-key
EXTERNAL_TIMEOUT_MS=20000

# Testing & Continuous Integration
# Set to 'true' to run real network downloads against public media URLs in integration tests
RUN_PROVIDER_INTEGRATION_TESTS=false
