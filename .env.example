# ==============================================================================
# hax-media-downloader Environment Configuration
# Owner/Author: Hamza
# Consumer: WhatsApp Bot "Tanu-xai"
# ==============================================================================

# Application Environment & Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=hax-media-downloader
APP_URL=http://localhost:3000

# Security & Authentication
ADMIN_API_KEY=hax-admin-super-secret-key-change-in-prod
API_KEY_HEADER=x-api-key
CORS_ORIGIN=*

# Rate Limiting (Downloads per hour per IP / user)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=3600000
ADMIN_RATE_LIMIT_MAX_REQUESTS=1000
ADMIN_RATE_LIMIT_WINDOW_MS=3600000

# Cache Configuration (TTL in seconds)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800
JOB_EXPIRATION_SECONDS=3600

# Provider Selection & Priorities (comma-separated: ytdlp,cobalt,external)
PROVIDER_PRIORITY=ytdlp,cobalt,external
PROVIDER_TIMEOUT_MS=15000

# yt-dlp Provider Configuration
YTDLP_ENABLED=true
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT_MS=30000

# Cobalt Provider Configuration (Self-hosted or managed instance)
# Leave empty to keep Cobalt provider marked as unavailable
COBALT_ENABLED=true
COBALT_API_URL=
COBALT_API_KEY=

# External API Provider Configuration (Generic 3rd-party provider)
# Leave empty to keep External provider marked as unavailable
EXTERNAL_API_ENABLED=true
EXTERNAL_API_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_HEADER=x-api-key
