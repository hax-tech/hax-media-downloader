# Server Configuration
PORT=3000
HOST=0.0.0.0
APP_NAME=hax-media-downloader
APP_URL=http://localhost:3000
CORS_ORIGIN=*

# Security & Access Control
ADMIN_API_KEY=
CRON_SECRET=
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=3600000

# Storage & Cache Configuration
TEMP_DIR=/app/temp
MAX_CONCURRENT_DOWNLOADS=3
CACHE_ENABLED=true
CACHE_TTL=1800
JOB_TTL=3600

# Provider Prioritization (comma-separated: ytdlp, cobalt, external)
PROVIDER_PRIORITY=ytdlp,cobalt,external
PROVIDER_TIMEOUT_MS=30000

# yt-dlp Provider Configuration
YTDLP_ENABLED=true
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT=45000
YTDLP_MAX_FILE_SIZE=100M
# JS Runtime for YouTube challenges: auto, node, deno, or none
YTDLP_JS_RUNTIME=auto
# EJS source: github, local, or none
YTDLP_EJS_SOURCE=github
# Optional cookies file to bypass bot verification on datacenter IPs
YTDLP_COOKIES_FILE=
# Optional HTTP/SOCKS5 proxy for yt-dlp requests
YTDLP_PROXY=

# Cobalt Provider Configuration (Optional)
COBALT_ENABLED=false
COBALT_API_URL=https://api.cobalt.tools
COBALT_API_KEY=
COBALT_TIMEOUT_MS=20000

# External Fallback Provider Configuration (Optional)
EXTERNAL_API_ENABLED=false
EXTERNAL_API_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_HEADER=x-api-key
EXTERNAL_TIMEOUT_MS=20000

# Testing & CI
RUN_PROVIDER_INTEGRATION_TESTS=false