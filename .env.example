# ==============================================================================
# hax-media-downloader Environment Configuration
# Owner/Author: Hamza
# Client / Consumer: WhatsApp Bot "Tanu-xai"
# ==============================================================================

# Server & Core Configuration
PORT=3000
NODE_ENV=production
APP_NAME=hax-media-downloader
APP_URL=http://localhost:3000

# Security & Authentication (Constant-Time Verification)
ADMIN_API_KEY=
CRON_SECRET=

# Temporary Storage & Processing Limits
TEMP_DIR=./temp
MAX_CONCURRENT_DOWNLOADS=3

# yt-dlp Provider Configuration (Priority #1)
YTDLP_ENABLED=true
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT=45000
YTDLP_MAX_FILE_SIZE=100M

# Cobalt Provider Configuration (Priority #2)
# Set COBALT_API_URL to your self-hosted or managed instance (e.g., http://cobalt:9000).
# If left empty, Cobalt provider status is reported as unavailable without crashing.
COBALT_ENABLED=true
COBALT_API_URL=
COBALT_API_KEY=

# External API Provider Configuration (Priority #3)
EXTERNAL_API_ENABLED=false
EXTERNAL_API_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_HEADER=x-api-key

# Rate Limiting Foundation
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=3600000

# Cache & Job Lifecycle Retention
CACHE_TTL=1800
JOB_TTL=3600

# Provider Priority Fallback Chain (comma-separated: ytdlp,cobalt,external)
PROVIDER_PRIORITY=ytdlp,cobalt,external
